  "matchWindowMin": 10,
  "wakeJumpS": 90,
  "boardWriteTools": [
    {
      "tool": "mcp__plane__create_work_item_comment",
      "card": "work_item_id",
      "body": "comment_html"
    },
    {
      "tool": [
        "Bash",
        "PowerShell"
      ],
      "command": "plane.py",
      "sub": "close",
      "bodyArg": 1
    },
    {
      "tool": [
        "Bash",
        "PowerShell"
      ],
      "command": "plane.py",
      "sub": "comment",
      "bodyArg": 0
    }
  ],
  "pult": {
    "enabled": false,
    "words": false
  },
  "statsEveryMin": 10,
  "indexWriteEveryS": 60,
  "rulesReread": {
    "files": [
      "CLAUDE.md",
      "unorbis/_meta/Субагенты Claude Code.md",
      "~/.claude/CLAUDE.md"
    ]
