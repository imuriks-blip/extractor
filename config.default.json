{
  "port": 4317,
  "toastAppId": "Unorbis.Extractor",
  "toasts": true,
  "paths": {
    "board": "C:/projects/unorbis-board",
    "boardLib": "C:/projects/unorbis-board/tools/lib",
    "registry": "C:/Users/imuri/.claude/skills/unorbis-projects/tools/registry.json",
    "journals": "C:/Users/imuri/.claude/projects",
    "sessions": "C:/Users/imuri/.claude/sessions",
    "desktopIndex": [
      "C:/Users/imuri/AppData/Roaming/Claude/claude-code-sessions",
      "C:/Users/imuri/AppData/Local/Packages/Claude_pzs8sxrjxfjjc/LocalCache/Roaming/Claude/claude-code-sessions"
    ],
    "agents": "C:/Users/imuri/.claude/agents",
    "vault": "C:/Users/imuri/Documents/Obsidian Vault"
  },
  "pollMs": {
    "board": 5000,
    "processes": 2000,
    "journals": 2000,
    "git": 30000,
    "desktopIndex": 10000
  },
  "thresholds": {
    "taktYellowMin": 60,
    "taktRedMin": 180,
    "waitingOverDayHours": 24,
    "staleMin": 15,
    "runSilentMin": 30
